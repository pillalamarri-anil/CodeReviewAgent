# --- LLM provider ---------------------------------------------------------
# 'openai' for the live demo; 'mock' for tests / offline dev only.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: only set if using a non-default OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# --- GitHub --------------------------------------------------------------
# In GitHub Actions, GITHUB_TOKEN is injected automatically.
GITHUB_TOKEN=
# owner/repo -- Actions sets GITHUB_REPOSITORY automatically.
GITHUB_REPOSITORY=pillalamarri-anil/BookMyShow
GITHUB_API_URL=https://api.github.com

# --- Review knobs ------------------------------------------------------
MIN_CONFIDENCE=0.75
MAX_CONTEXT_TOKENS=8000

# --- Quality gate ----------------------------------------------------
MAX_CRITICAL=0
MAX_HIGH=0
MAX_MEDIUM=5
