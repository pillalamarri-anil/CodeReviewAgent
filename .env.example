# --- LLM provider ---------------------------------------------------------
# 'azure_openai' for the live demo; 'mock' for tests / offline dev only.
LLM_PROVIDER=azure_openai

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# --- GitHub --------------------------------------------------------------
# In GitHub Actions, GITHUB_TOKEN is injected automatically.
GITHUB_TOKEN=
# owner/repo -- Actions sets GITHUB_REPOSITORY automatically.
GITHUB_REPOSITORY=pillalamarri-anil/BookMyShow
GITHUB_API_URL=https://api.github.com

# --- Review knobs ------------------------------------------------------
MIN_CONFIDENCE=0.75
MAX_CONTEXT_TOKENS=8000

# --- Quality gate ----------------------------------------------------
MAX_CRITICAL=0
MAX_HIGH=0
MAX_MEDIUM=5
